   "source": [
    "from enum import Enum\n",
    "import random\n",
    "%pip install dotmap\n",
    "from dotmap import DotMap\n",
    "\n",
    "class choices(Enum):\n",
    "  First = 0\n",
    "  Second = 2\n",
    "  Third = 3\n",
    "\n",
    "positions = {\"cent\":3,\n",
    "             \"done\":1}\n",
    "positions = DotMap(positions)\n",
    "\n",
    "print(random.choice(list(choices)))\n",
    "print(positions.cent)"
   ]
